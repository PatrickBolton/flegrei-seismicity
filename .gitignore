# Raw downloads: large, and re-creatable with scripts/ (see README for sources)
data/raw/

# Papers (PDFs): usually copyrighted, so kept local, never committed
papers/

# Processed tables: re-created by scripts/process_data.py
data/processed/*
!data/processed/.gitkeep

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Model artefacts and large outputs
*.pkl
*.joblib
models/

# Secrets
.env

# OS / editor
.DS_Store
.vscode/
.idea/
